APP_ENV=development

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# PostgreSQL Configuration
PROJECT_NAME="BIS RAG Engine"
BIS_BASE_URL=https://www.bis.gov.in
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bis_rag
POSTGRES_DB=bis_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Crawler & Download Settings
REQUEST_TIMEOUT=20
MAX_CRAWL_DEPTH=3
CRAWL_DELAY=0.5
DOCUMENT_MAX_SIZE=26214400

# RAG & Lazy Ingestion Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_TOP_K=10
RERANK_TOP_K=5
DOCUMENT_SELECTION_LIMIT=3
MAX_RETRIEVAL_LOOPS=2
