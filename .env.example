# ============================================================
# BIS RAG Engine - environment configuration
#
# Copy this file to .env and fill in the values:
#     cp .env.example .env
#
# Every variable here maps 1:1 onto a field of
# Settings in app/config.py. Anything left out uses
# the default shown in the comment.
# ============================================================

# ---------------- Application ----------------
# PROJECT_NAME="BIS RAG Engine"
# APP_ENV=development                 # development | production
# LOG_LEVEL=INFO

# ---------------- Groq / LLM (REQUIRED) ----------------
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=

# Model used by the ingestion structuring stage (app/steps/structure.py)
# GROQ_STRUCTURE_MODEL=openai/gpt-oss-120b

# Model used for answer generation (app/rag/generator.py)
# GROQ_MODEL=openai/gpt-oss-20b

# Set to false to skip LLM structuring entirely and use the
# deterministic Python classifier for the whole document.
# LLM_ENABLED=true

# Retry / backoff applied to every Groq call.
# GROQ_MAX_RETRIES=3
# GROQ_RETRY_BASE_DELAY=1.0
# GROQ_RETRY_MAX_DELAY=20.0

# When false (default), a Groq batch that fails after all retries
# aborts ingestion instead of silently degrading to heuristic
# output. Set to true only if degraded structuring is acceptable.
# STRUCTURE_ALLOW_FALLBACK=false

# ---------------- Structuring ----------------
# STRUCTURE_BATCH_SIZE=20
# STRUCTURE_MAX_OUTPUT_TOKENS=8000

# ---------------- Chunking ----------------
# MAX_CHUNK_CHARS=4000
# MIN_CHUNK_CHARS=250

# ---------------- Embedding / vector index ----------------
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_BATCH_SIZE=16
# CHROMA_COLLECTION_NAME=bis_documents

# ---------------- Retrieval ----------------
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# HYBRID_ALPHA=0.65                   # weight of dense score in fusion
# RETRIEVAL_TOP_K=10
# DENSE_K=15
# BM25_K=15
# RERANK_TOP_K=5

# ---------------- Generation ----------------
# GENERATION_TEMPERATURE=0.1
# GENERATION_MAX_TOKENS=1200
