FROM complywiseacr.azurecr.io/bis-system-v5:corpus-release-0001-789a18e001

WORKDIR /app

# Intentional offline model cache configuration (eliminates ENOSPC and runtime downloads)
ENV HF_HOME=/app/model_cache
ENV TRANSFORMERS_CACHE=/app/model_cache/hub
ENV SENTENCE_TRANSFORMERS_HOME=/app/model_cache/hub
ENV TORCH_HOME=/app/model_cache
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV TRANSFORMERS_NO_TF=1
ENV USE_TF=0
ENV TMPDIR=/app/data/tmp

# Copy updated application code and knowledge database
COPY requirements.txt .
COPY app/ app/
COPY data/knowledge/bis_knowledge.db data/knowledge/bis_knowledge.db

ENV PORT=8001
ENV HOST=0.0.0.0
EXPOSE 8001

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
