FROM complywiseacr.azurecr.io/bis-system-v5:984a5a4

WORKDIR /app

# Intentional offline model cache configuration (eliminates ENOSPC and runtime downloads)
ENV HF_HOME=/app/model_cache
ENV TRANSFORMERS_CACHE=/app/model_cache
ENV SENTENCE_TRANSFORMERS_HOME=/app/model_cache
ENV TORCH_HOME=/app/model_cache
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV TRANSFORMERS_NO_TF=1
ENV USE_TF=0

# Copy application code, knowledge databases, ChromaDB vectors, and pre-baked model cache
COPY . .

ENV PORT=8001
ENV HOST=0.0.0.0
EXPOSE 8001

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
