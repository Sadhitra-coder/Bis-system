    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Liveness. The process is up and serving.\n\nDeliberately does NOT consider index state: a stale index is a data\nproblem, not a reason for an orchestrator to restart the container.\nUse /ready for that.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness Check",
        "description": "Readiness, including whether the persisted index matches the schema the\nrunning code expects.\n\nReturns 503 when the index cannot be trusted. The previous behaviour \u2014\nreporting 'ok' whenever the collection was non-empty \u2014 let an index full\nof superseded metadata look healthy indefinitely.\n\nState is read from request.app rather than the module-level `app` so the\nhandler reports on whichever application is actually serving it.",
        "operationId": "readiness_check_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
